        {"type": "TextHeading", "text": "Adicionar mais produtos"},
        {"type": "TextBody", "text": "${data.message}"},
        {"type": "TextCaption", "text": "Etapa 1 de 3 · carregamos somente produtos relevantes à sua busca."},
        {"type": "Form", "name": "extras_form_1", "children": [
          {"type": "Dropdown", "label": "Como deseja continuar?", "name": "extras_action", "data-source": "${data.extras_actions}", "required": true},
          {"type": "Dropdown", "label": "Seção (se escolher por seção)", "name": "section_key", "data-source": "${data.sections}", "required": false},
          {"type": "TextInput", "label": "Buscar produto (opcional)", "name": "direct_query", "required": false},
