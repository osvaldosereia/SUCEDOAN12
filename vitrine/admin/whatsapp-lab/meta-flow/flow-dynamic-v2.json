{
  "version": "7.3",
  "data_api_version": "3.0",
  "routing_model": {
    "TAMANHO": [
      "TIPO_PRODUTO"
    ],
    "TIPO_PRODUTO": [
      "OPCAO_EDIT",
      "RESUMO"
    ],
    "OPCAO_EDIT": [],
    "RESUMO": []
  },
  "screens": [
    {
      "id": "TAMANHO",
      "title": "Escolha a cesta",
      "data": {
        "tamanhos": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              },
              "title": {
                "type": "string"
              },
              "description": {
                "type": "string"
              }
            }
          },
          "__example__": [
            {
              "id": "mini",
              "title": "Mini"
            },
            {
              "id": "economica",
              "title": "Econômica"
            },
            {
              "id": "pequena",
              "title": "Pequena"
            },
            {
              "id": "media",
              "title": "Média"
            },
            {
              "id": "grande",
              "title": "Grande"
            }
          ]
        }
      },
      "layout": {
        "type": "SingleColumnLayout",
        "children": [
          {
            "type": "TextHeading",
            "text": "Qual tamanho de cesta?"
          },
          {
            "type": "TextBody",
            "text": "Veja o valor a partir da combinação mais barata. Depois, escolha os produtos e as quantidades."
          },
          {
            "type": "RadioButtonsGroup",
            "name": "tamanho",
            "label": "Tamanho e preço inicial",
            "required": true,
            "data-source": "${data.tamanhos}"
          },
          {
            "type": "Footer",
            "label": "Personalizar cesta",
            "on-click-action": {
              "name": "data_exchange",
              "payload": {
                "etapa": "tamanho",
                "tamanho": "${form.tamanho}"
              }
            }
          }
        ]
      }
    },
    {
      "id": "TIPO_PRODUTO",
      "title": "Escolha os produtos",
      "data": {
        "estado": {
          "type": "string",
          "__example__": ""
        },
        "tipo_nome": {
          "type": "string",
          "__example__": ""
        },
        "etapa_texto": {
          "type": "string",
          "__example__": ""
        },
        "lista_titulo": {
          "type": "string",
          "__example__": ""
        },
        "lista_descricao": {
          "type": "string",
          "__example__": ""
        },
        "aviso": {
          "type": "string",
          "__example__": ""
        },
        "tem_aviso": {
          "type": "boolean",
          "__example__": false
        },
        "itens_lista": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              },
              "main-content": {
                "type": "object",
                "properties": {
                  "title": {
                    "type": "string"
                  },
                  "description": {
                    "type": "string"
                  },
                  "metadata": {
                    "type": "string"
                  }
                }
              },
              "on-click-action": {
                "type": "object",
                "properties": {
                  "name": {
                    "type": "string"
                  },
                  "payload": {
                    "type": "object",
                    "properties": {
                      "etapa": {
                        "type": "string"
                      },
                      "estado": {
                        "type": "string"
                      },
                      "position_id": {
                        "type": "string"
                      },
                      "product_id": {
                        "type": "string"
                      },
                      "pagina": {
                        "type": "string"
                      }
                    }
                  }
                }
              }
            },
            "optionalProperties": {
              "start": {
                "type": "object",
                "properties": {
                  "image": {
                    "type": "string"
                  },
                  "alt-text": {
                    "type": "string"
                  }
                }
              }
            }
          },
          "__example__": []
        }
      },
      "layout": {
        "type": "SingleColumnLayout",
        "children": [
          {
            "type": "NavigationList",
            "name": "opcoes",
            "list-items": "${data.itens_lista}",
            "label": "${data.lista_titulo}",
            "description": "${data.lista_descricao}",
            "media-size": "regular"
          }
        ]
      }
    },
    {
      "id": "OPCAO_EDIT",
      "title": "Quantidade do produto",
      "data": {
        "estado": {
          "type": "string",
          "__example__": ""
        },
        "position_id": {
          "type": "string",
          "__example__": ""
        },
        "product_id": {
          "type": "string",
          "__example__": ""
        },
        "titulo": {
          "type": "string",
          "__example__": ""
        },
        "nome": {
          "type": "string",
          "__example__": ""
        },
        "imagem": {
          "type": "string",
          "__example__": ""
        },
        "tem_imagem": {
          "type": "boolean",
          "__example__": false
        },
        "quantidade": {
          "type": "string",
          "__example__": "0"
        },
        "preco": {
          "type": "string",
          "__example__": ""
        },
        "estoque": {
          "type": "string",
          "__example__": ""
        },
        "max_quantidade": {
          "type": "string",
          "__example__": "10"
        },
        "preco_estoque": {
          "type": "string",
          "__example__": ""
        },
        "aviso": {
          "type": "string",
          "__example__": ""
        },
        "tem_aviso": {
          "type": "boolean",
          "__example__": false
        }
      },
      "layout": {
        "type": "SingleColumnLayout",
        "children": [
          {
            "type": "TextHeading",
            "text": "${data.titulo}"
          },
          {
            "type": "Image",
            "src": "${data.imagem}",
            "visible": "${data.tem_imagem}",
            "width": 240,
            "height": 190,
            "aspect-ratio": 1.26,
            "scale-type": "contain",
            "alt-text": "${data.nome}"
          },
          {
            "type": "TextSubheading",
            "text": "${data.nome}"
          },
          {
            "type": "TextBody",
            "text": "${data.preco_estoque}"
          },
          {
            "type": "TextCaption",
            "text": "${data.aviso}",
            "visible": "${data.tem_aviso}",
            "font-weight": "bold"
          },
          {
            "type": "TextInput",
            "name": "quantidade",
            "label": "Quantidade",
            "input-type": "number",
            "required": true,
            "max-chars": 2,
            "pattern": "^(10|[0-9])$",
            "helper-text": "Digite de 0 a 10. Zero remove esta opção.",
            "init-value": "${data.quantidade}"
          },
          {
            "type": "Footer",
            "label": "Salvar quantidade",
            "on-click-action": {
              "name": "data_exchange",
              "payload": {
                "etapa": "salvar_opcao",
                "estado": "${data.estado}",
                "position_id": "${data.position_id}",
                "product_id": "${data.product_id}",
                "quantidade": "${form.quantidade}"
              }
            }
          }
        ]
      }
    },
    {
      "id": "RESUMO",
      "title": "Resumo da cesta",
      "terminal": true,
      "data": {
        "resumo": {
          "type": "string",
          "__example__": "Resumo da cesta selecionada"
        },
        "valor": {
          "type": "string",
          "__example__": "Valor atualizado pelo Supabase"
        },
        "itens": {
          "type": "string",
          "__example__": "Itens carregados do catálogo"
        },
        "estado": {
          "type": "string",
          "__example__": "test-preview-only"
        }
      },
      "layout": {
        "type": "SingleColumnLayout",
        "children": [
          {
            "type": "TextHeading",
            "text": "Revise sua cesta"
          },
          {
            "type": "TextSubheading",
            "text": "${data.resumo}"
          },
          {
            "type": "TextBody",
            "text": "${data.itens}"
          },
          {
            "type": "TextSubheading",
            "text": "Total atualizado"
          },
          {
            "type": "TextBody",
            "text": "${data.valor}"
          },
          {
            "type": "TextCaption",
            "text": "Esta é uma solicitação. A equipe confirmará preço, estoque e disponibilidade antes de registrar o pedido."
          },
          {
            "type": "Footer",
            "label": "Enviar solicitação",
            "on-click-action": {
              "name": "complete",
              "payload": {
                "resultado": "solicitacao_para_atendimento",
                "resumo": "${data.resumo}",
                "valor": "${data.valor}",
                "itens": "${data.itens}"
              }
            }
          }
        ]
      }
    }
  ]
}
