{
  "version": "7.3",
  "data_api_version": "3.0",
  "routing_model": {
    "TAMANHO": [
      "COMBINACAO"
    ],
    "COMBINACAO": [
      "ITENS_UM"
    ],
    "ITENS_UM": [
      "ITEM_EDIT",
      "ITENS_DOIS",
      "RESUMO"
    ],
    "ITENS_DOIS": [
      "ITEM_EDIT",
      "RESUMO"
    ],
    "ITEM_EDIT": [],
    "RESUMO": []
  },
  "screens": [
    {
      "id": "TAMANHO",
      "title": "Escolha a cesta",
      "data": {
        "tamanhos": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              },
              "title": {
                "type": "string"
              },
              "description": {
                "type": "string"
              }
            }
          },
          "__example__": [
            {
              "id": "mini",
              "title": "Mini"
            },
            {
              "id": "economica",
              "title": "Econômica"
            },
            {
              "id": "pequena",
              "title": "Pequena"
            },
            {
              "id": "media",
              "title": "Média"
            },
            {
              "id": "grande",
              "title": "Grande"
            }
          ]
        }
      },
      "layout": {
        "type": "SingleColumnLayout",
        "children": [
          {
            "type": "TextHeading",
            "text": "Qual tamanho de cesta?"
          },
          {
            "type": "TextBody",
            "text": "Escolha um tamanho para conhecer as três combinações de marcas e seus valores."
          },
          {
            "type": "RadioButtonsGroup",
            "name": "tamanho",
            "label": "Tamanho da cesta",
            "required": true,
            "data-source": "${data.tamanhos}"
          },
          {
            "type": "Footer",
            "label": "Ver combinações",
            "on-click-action": {
              "name": "data_exchange",
              "payload": {
                "etapa": "tamanho",
                "tamanho": "${form.tamanho}"
              }
            }
          }
        ]
      }
    },
    {
      "id": "COMBINACAO",
      "title": "Combinações de marcas",
      "data": {
        "tamanho": {
          "type": "string",
          "__example__": "mini"
        },
        "resumoMarcas": {
          "type": "string",
          "__example__": "Marcas reais consultadas no catálogo"
        },
        "opcoes": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              },
              "title": {
                "type": "string"
              },
              "description": {
                "type": "string"
              }
            }
          },
          "__example__": [
            {
              "id": "1",
              "title": "Opção de cesta 1",
              "description": "Preço atual carregado do Supabase"
            },
            {
              "id": "2",
              "title": "Opção de cesta 2",
              "description": "Preço atual carregado do Supabase"
            },
            {
              "id": "3",
              "title": "Opção de cesta 3",
              "description": "Preço atual carregado do Supabase"
            }
          ]
        }
      },
      "layout": {
        "type": "SingleColumnLayout",
        "children": [
          {
            "type": "TextHeading",
            "text": "Escolha a combinação"
          },
          {
            "type": "TextBody",
            "text": "Preços e marcas atualizados conforme disponibilidade. Você poderá personalizar os produtos."
          },
          {
            "type": "TextBody",
            "text": "${data.resumoMarcas}"
          },
          {
            "type": "RadioButtonsGroup",
            "name": "combinacao",
            "label": "Combinações",
            "required": true,
            "data-source": "${data.opcoes}"
          },
          {
            "type": "Footer",
            "label": "Ver produtos",
            "on-click-action": {
              "name": "data_exchange",
              "payload": {
                "etapa": "combinacao",
                "tamanho": "${data.tamanho}",
                "combinacao": "${form.combinacao}"
              }
            }
          }
        ]
      }
    },
    {
      "id": "ITENS_UM",
      "title": "Produtos da cesta",
      "data": {
        "estado": {
          "type": "string",
          "__example__": ""
        },
        "lista_titulo": {
          "type": "string",
          "__example__": ""
        },
        "lista_descricao": {
          "type": "string",
          "__example__": ""
        },
        "itens_lista": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              },
              "main-content": {
                "type": "object",
                "properties": {
                  "title": {
                    "type": "string"
                  },
                  "description": {
                    "type": "string"
                  },
                  "metadata": {
                    "type": "string"
                  }
                }
              },
              "on-click-action": {
                "type": "object",
                "properties": {
                  "name": {
                    "type": "string"
                  },
                  "payload": {
                    "type": "object",
                    "properties": {
                      "etapa": {
                        "type": "string"
                      },
                      "estado": {
                        "type": "string"
                      },
                      "position_id": {
                        "type": "string"
                      },
                      "return_screen": {
                        "type": "string"
                      },
                      "pagina": {
                        "type": "string"
                      }
                    }
                  }
                }
              }
            },
            "optionalProperties": {
              "start": {
                "type": "object",
                "properties": {
                  "image": {
                    "type": "string"
                  },
                  "alt-text": {
                    "type": "string"
                  }
                }
              }
            }
          },
          "__example__": []
        }
      },
      "layout": {
        "type": "SingleColumnLayout",
        "children": [
          {
            "type": "NavigationList",
            "name": "catalogo",
            "list-items": "${data.itens_lista}",
            "label": "${data.lista_titulo}",
            "description": "${data.lista_descricao}",
            "media-size": "regular"
          }
        ]
      }
    },
    {
      "id": "ITENS_DOIS",
      "title": "Produtos da cesta",
      "data": {
        "estado": {
          "type": "string",
          "__example__": ""
        },
        "lista_titulo": {
          "type": "string",
          "__example__": ""
        },
        "lista_descricao": {
          "type": "string",
          "__example__": ""
        },
        "itens_lista": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              },
              "main-content": {
                "type": "object",
                "properties": {
                  "title": {
                    "type": "string"
                  },
                  "description": {
                    "type": "string"
                  },
                  "metadata": {
                    "type": "string"
                  }
                }
              },
              "on-click-action": {
                "type": "object",
                "properties": {
                  "name": {
                    "type": "string"
                  },
                  "payload": {
                    "type": "object",
                    "properties": {
                      "etapa": {
                        "type": "string"
                      },
                      "estado": {
                        "type": "string"
                      },
                      "position_id": {
                        "type": "string"
                      },
                      "return_screen": {
                        "type": "string"
                      },
                      "pagina": {
                        "type": "string"
                      }
                    }
                  }
                }
              }
            },
            "optionalProperties": {
              "start": {
                "type": "object",
                "properties": {
                  "image": {
                    "type": "string"
                  },
                  "alt-text": {
                    "type": "string"
                  }
                }
              }
            }
          },
          "__example__": []
        }
      },
      "layout": {
        "type": "SingleColumnLayout",
        "children": [
          {
            "type": "NavigationList",
            "name": "catalogo",
            "list-items": "${data.itens_lista}",
            "label": "${data.lista_titulo}",
            "description": "${data.lista_descricao}",
            "media-size": "regular"
          }
        ]
      }
    },
    {
      "id": "ITEM_EDIT",
      "title": "Editar produto",
      "data": {
        "estado": {
          "type": "string",
          "__example__": ""
        },
        "position_id": {
          "type": "string",
          "__example__": ""
        },
        "return_screen": {
          "type": "string",
          "__example__": ""
        },
        "titulo": {
          "type": "string",
          "__example__": ""
        },
        "nome": {
          "type": "string",
          "__example__": ""
        },
        "imagem": {
          "type": "string",
          "__example__": ""
        },
        "tem_imagem": {
          "type": "boolean",
          "__example__": false
        },
        "produto": {
          "type": "string",
          "__example__": ""
        },
        "quantidade": {
          "type": "string",
          "__example__": "1"
        },
        "alternativas": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              },
              "title": {
                "type": "string"
              }
            },
            "optionalProperties": {
              "description": {
                "type": "string"
              },
              "image": {
                "type": "string"
              },
              "alt-text": {
                "type": "string"
              },
              "enabled": {
                "type": "boolean"
              }
            }
          },
          "__example__": []
        },
        "preco": {
          "type": "string",
          "__example__": ""
        },
        "estoque": {
          "type": "string",
          "__example__": ""
        },
        "preco_estoque": {
          "type": "string",
          "__example__": ""
        },
        "aviso": {
          "type": "string",
          "__example__": "Quantidade disponível."
        },
        "tem_aviso": {
          "type": "boolean",
          "__example__": false
        }
      },
      "layout": {
        "type": "SingleColumnLayout",
        "children": [
          {
            "type": "TextHeading",
            "text": "${data.titulo}"
          },
          {
            "type": "Image",
            "src": "${data.imagem}",
            "visible": "${data.tem_imagem}",
            "width": 240,
            "height": 190,
            "aspect-ratio": 1.26,
            "scale-type": "contain",
            "alt-text": "${data.nome}"
          },
          {
            "type": "TextSubheading",
            "text": "${data.nome}"
          },
          {
            "type": "TextBody",
            "text": "${data.preco_estoque}"
          },
          {
            "type": "TextCaption",
            "text": "${data.aviso}",
            "visible": "${data.tem_aviso}",
            "font-weight": "bold"
          },
          {
            "type": "RadioButtonsGroup",
            "name": "produto",
            "label": "Marca / produto",
            "required": true,
            "data-source": "${data.alternativas}",
            "init-value": "${data.produto}"
          },
          {
            "type": "TextInput",
            "name": "quantidade",
            "label": "Quantidade",
            "input-type": "number",
            "required": true,
            "max-chars": 2,
            "pattern": "^(10|[0-9])$",
            "helper-text": "Digite de 0 a 10. Zero retira o produto.",
            "init-value": "${data.quantidade}"
          },
          {
            "type": "Footer",
            "label": "Salvar e voltar",
            "on-click-action": {
              "name": "data_exchange",
              "payload": {
                "etapa": "salvar_item",
                "estado": "${data.estado}",
                "position_id": "${data.position_id}",
                "return_screen": "${data.return_screen}",
                "produto": "${form.produto}",
                "quantidade": "${form.quantidade}"
              }
            }
          }
        ]
      }
    },
    {
      "id": "RESUMO",
      "title": "Resumo da cesta",
      "terminal": true,
      "data": {
        "resumo": {
          "type": "string",
          "__example__": "Resumo da cesta selecionada"
        },
        "valor": {
          "type": "string",
          "__example__": "Valor atualizado pelo Supabase"
        },
        "itens": {
          "type": "string",
          "__example__": "Itens carregados do catálogo"
        },
        "estado": {
          "type": "string",
          "__example__": "test-preview-only"
        }
      },
      "layout": {
        "type": "SingleColumnLayout",
        "children": [
          {
            "type": "TextHeading",
            "text": "Revise sua cesta"
          },
          {
            "type": "TextSubheading",
            "text": "${data.resumo}"
          },
          {
            "type": "TextBody",
            "text": "${data.itens}"
          },
          {
            "type": "TextSubheading",
            "text": "Total atualizado"
          },
          {
            "type": "TextBody",
            "text": "${data.valor}"
          },
          {
            "type": "TextCaption",
            "text": "Esta é uma solicitação. A equipe confirmará preço, estoque e disponibilidade antes de registrar o pedido."
          },
          {
            "type": "Footer",
            "label": "Enviar solicitação",
            "on-click-action": {
              "name": "complete",
              "payload": {
                "resultado": "solicitacao_para_atendimento",
                "resumo": "${data.resumo}",
                "valor": "${data.valor}",
                "itens": "${data.itens}"
              }
            }
          }
        ]
      }
    }
  ]
}
