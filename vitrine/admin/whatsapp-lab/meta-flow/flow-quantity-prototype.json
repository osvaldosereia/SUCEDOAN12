{
  "version": "7.3",
  "routing_model": {
    "TAMANHO": [
      "COMBINACAO"
    ],
    "COMBINACAO": [
      "PRODUTOS"
    ],
    "PRODUTOS": []
  },
  "screens": [
    {
      "id": "TAMANHO",
      "title": "Escolha a cesta",
      "data": {},
      "layout": {
        "type": "SingleColumnLayout",
        "children": [
          {
            "type": "TextHeading",
            "text": "Qual tamanho de cesta?"
          },
          {
            "type": "TextBody",
            "text": "Escolha um tamanho. Na etapa seguinte, você poderá escolher uma combinação de marcas."
          },
          {
            "type": "RadioButtonsGroup",
            "name": "tamanho",
            "label": "Tamanho da cesta",
            "required": true,
            "data-source": [
              {
                "id": "mini",
                "title": "Mini"
              },
              {
                "id": "economica",
                "title": "Econômica"
              },
              {
                "id": "pequena",
                "title": "Pequena"
              },
              {
                "id": "media",
                "title": "Média"
              },
              {
                "id": "grande",
                "title": "Grande"
              }
            ]
          },
          {
            "type": "Footer",
            "label": "Continuar",
            "on-click-action": {
              "name": "navigate",
              "next": {
                "type": "screen",
                "name": "COMBINACAO"
              },
              "payload": {
                "tamanho": "${form.tamanho}"
              }
            }
          }
        ]
      }
    },
    {
      "id": "COMBINACAO",
      "title": "Escolha a combinação",
      "data": {
        "tamanho": {
          "type": "string",
          "__example__": "mini"
        }
      },
      "layout": {
        "type": "SingleColumnLayout",
        "children": [
          {
            "type": "TextHeading",
            "text": "Escolha uma combinação"
          },
          {
            "type": "TextBody",
            "text": "Temos três opções de marcas. O preço será confirmado com o estoque atual."
          },
          {
            "type": "RadioButtonsGroup",
            "name": "combinacao",
            "label": "Combinação de marcas",
            "required": true,
            "data-source": [
              {
                "id": "1",
                "title": "Combinação 1"
              },
              {
                "id": "2",
                "title": "Combinação 2"
              },
              {
                "id": "3",
                "title": "Combinação 3"
              }
            ]
          },
          {
            "type": "Footer",
            "label": "Ver produtos",
            "on-click-action": {
              "name": "navigate",
              "next": {
                "type": "screen",
                "name": "PRODUTOS"
              },
              "payload": {
                "tamanho": "${data.tamanho}",
                "combinacao": "${form.combinacao}"
              }
            }
          }
        ]
      }
    },
    {
      "id": "PRODUTOS",
