# Backend canônico: Dona Antônia original (ssbesxgaijknwsjbsbcz).
NEXT_PUBLIC_SUPABASE_URL=https://ssbesxgaijknwsjbsbcz.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me
# Server-side Supabase default secret key only. Never expose this through NEXT_PUBLIC_*.
SUPABASE_SECRET_KEY=replace_with_supabase_secret_key
# Set each value in Supabase Edge Function secrets from the Meta App assigned to that WABA.
# If both numbers use one Meta App, the same app secret can be stored under both names.
META_WHATSAPP_APP_SECRET_0975=replace_with_meta_app_secret
META_WHATSAPP_APP_SECRET_1018=replace_with_meta_app_secret
META_ACCESS_TOKEN_0975=replace_with_meta_access_token
META_ACCESS_TOKEN_1018=replace_with_meta_access_token
# Compatibility key used only to re-sign internal forwarding to the existing webhook.
# It must match META_WHATSAPP_APP_SECRET configured for that legacy function; never use it
# to validate the original incoming Meta request.
META_WHATSAPP_APP_SECRET=replace_with_legacy_webhook_compatibility_secret
META_GRAPH_API_VERSION=replace_with_current_supported_version
# Keep false until the final fiscal milestone. This never belongs in NEXT_PUBLIC_*.
ADMIN_FISCAL_ISSUANCE_ENABLED=false
# Keep false until Bling order recovery is homologated in an isolated environment.
ADMIN_BLING_ORDER_RECOVERY_ENABLED=false
