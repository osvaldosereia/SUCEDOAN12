					"__example__": ["2x Arroz Tio Alvino"]
				},
				"product_summary_text": {
					"type": "string",
					"__example__": "2x Arroz Tio Alvino"
				},
				"total_cents": {
					"type": "number",
					"__example__": 5780
				},
				"total_label": {
					"type": "string",
					"__example__": "R$ 57,80"
				},
				"delivery_address_text": {
					"type": "string",
					"__example__": "Rua das Flores, 123 · Centro · Várzea Grande/MT · 78110-000"
				}
			},
			"layout": {
				"type": "SingleColumnLayout",
				"children": [
					{
						"type": "Form",
						"name": "order_review_form",
						"children": [
							{
								"type": "TextHeading",
								"text": "Revise seu pedido"
							},
							{
								"type": "TextSubheading",
								"text": "Produtos e quantidades"
							},
							{
								"type": "TextBody",
								"text": "${data.product_summary_text}"
							},
							{
								"type": "TextSubheading",
								"text": "Forma de pagamento"
							},
							{
								"type": "TextBody",
								"text": "${data.payment_label}"
							},
							{
								"type": "TextSubheading",
								"text": "Endereço de entrega"
							},
							{
								"type": "TextBody",
								"text": "${data.delivery_address_text}"
							},
							{
								"type": "TextSubheading",
								"text": "Total do pedido"
							},
							{
								"type": "TextHeading",
								"text": "${data.total_label}"
							},
							{
								"type": "Footer",
								"label": "Enviar pedido",
								"on-click-action": {
									"name": "complete",
									"payload": {
										"flow_session_id": "${data.flow_session_id}",
										"selected_items": "${data.selected_items}",
										"payment_method": "${data.payment_method}",
										"customer_id": "${data.customer_id}",
										"customer_name": "${data.customer_name}",
										"address_id": "${data.address_id}",
										"new_address": "${data.new_address}",
										"total_cents": "${data.total_cents}",
										"delivery_address_text": "${data.delivery_address_text}"
									}
								}
							}
						]
					}
				]
			}
		}
	]
}
