VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=YOUR_SUPABASE_PUBLISHABLE_KEY

# Supabase Edge Functions inject SUPABASE_URL, SUPABASE_DB_URL,
# SUPABASE_PUBLISHABLE_KEYS and SUPABASE_SECRET_KEYS at runtime.
# Do not add these reserved SUPABASE_* names through the secrets manager.
# Configure only as Supabase Edge Function secrets. Never prefix these with VITE_.
ADMIN_ALLOWED_USER_IDS=YOUR_AUTH_USER_UUID
ADMIN_ALLOWED_ORIGINS=https://YOUR_ADMIN_ORIGIN
GITHUB_APP_ID=YOUR_GITHUB_APP_ID
GITHUB_INSTALLATION_ID=YOUR_GITHUB_APP_INSTALLATION_ID
GITHUB_PRIVATE_KEY=YOUR_GITHUB_APP_PRIVATE_KEY_PEM

# Configure only in server-side Supabase Edge Function secrets; no values belong in the browser.
META_APP_SECRET=YOUR_META_APP_SECRET
META_WEBHOOK_VERIFY_TOKEN=YOUR_RANDOM_WEBHOOK_VERIFICATION_TOKEN
META_PHONE_NUMBER_ID_0975=YOUR_VERIFIED_META_PHONE_NUMBER_ID
META_PHONE_NUMBER_ID_1018=YOUR_VERIFIED_META_PHONE_NUMBER_ID
META_OUTBOX_ENCRYPTION_KEY=BASE64_ENCODED_32_BYTE_KEY
META_ACCESS_TOKEN_0975=YOUR_SERVER_SIDE_META_ACCESS_TOKEN
META_ACCESS_TOKEN_1018=YOUR_SERVER_SIDE_META_ACCESS_TOKEN
META_GRAPH_API_VERSION=YOUR_CURRENT_SUPPORTED_VERSION
WHATSAPP_FLOW_ENDPOINT_URI=https://YOUR_PROJECT_REF.supabase.co/functions/v1/whatsapp-flow-runtime
META_FLOW_PRIVATE_KEY_0975=YOUR_CHANNEL_0975_RSA_PRIVATE_KEY_PEM
META_FLOW_PRIVATE_KEY_1018=YOUR_CHANNEL_1018_RSA_PRIVATE_KEY_PEM
META_OUTBOX_SENDER_ENABLED=false
META_OUTBOX_DISPATCH_SECRET=GENERATE_A_RANDOM_SECRET_OF_AT_LEAST_32_CHARACTERS
# The published Flow ID is selected per channel in the Admin and stored in
# whatsapp_atendimento.channel_flow_bindings; it is not a deploy-time secret.

# Bling OAuth and product lookup remain disabled until the connection is deliberately enabled.
# Configure only as Supabase Edge Function secrets; never add these to VITE_* variables.
BLING_OAUTH_ENABLED=false
BLING_PRODUCT_LOOKUP_ENABLED=false
BLING_SALE_RECONCILIATION_ENABLED=false
BLING_CLIENT_ID=YOUR_BLING_CLIENT_ID
BLING_CLIENT_SECRET=YOUR_BLING_CLIENT_SECRET
BLING_REDIRECT_URI=https://YOUR_PROJECT_REF.supabase.co/functions/v1/whatsapp-admin-api/integrations/bling/oauth/callback
BLING_TOKEN_ENCRYPTION_KEY=BASE64_ENCODED_32_BYTE_KEY
