{
  "name": "dona-antonia-v2",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "check": "tsc --noEmit",
    "test": "vitest run src scripts/import-bling.test.mjs",
    "import:bling": "node scripts/import-bling.mjs",
    "e2e": "playwright test",
    "architecture:check": "node scripts/check-architecture.mjs",
    "r15:audit": "node scripts/r15-audit.mjs",
    "lint": "eslint . --ext .js,.mjs,.ts,.tsx",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\" \"e2e/**/*.ts\" \"scripts/**/*.mjs\" \"*.{json,html,ts,js}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css}\" \"e2e/**/*.ts\" \"scripts/**/*.mjs\" \"*.{json,html,ts,js}\"",
    "test:db": "node scripts/test-schema.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.118.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@electric-sql/pglite": "0.5.11",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "csv-parse": "7.0.3",
    "eslint": "10.13.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.13.0",
    "prettier": "3.9.10",
    "typescript": "^5.9.0",
    "typescript-eslint": "8.72.0",
    "vite": "^7.0.0",
    "vitest": "4.1.12"
  }
}
